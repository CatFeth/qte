#!/usr/bin/env bash
# ==============================================================================
# Quanteq | VPS Optimizer & RemnaNode Installer
# Docs: https://docs.rw
# WARP: https://github.com/distillium/warp-native
# ==============================================================================

set -uo pipefail
shopt -s extglob

export LC_ALL=C.UTF-8 2>/dev/null || export LC_ALL=C
export DEBIAN_FRONTEND=noninteractive
export NEEDRESTART_MODE=a
export NEEDRESTART_SUSPEND=1

readonly LOG_FILE="/tmp/quanteq-install.log"
readonly REMNANODE_DIR="/opt/remnanode"
readonly REMNANODE_PORT="2222"
readonly ICMP_RATE_LIMIT="100/s"
readonly ICMP_RATE_BURST="200"

# --- ANSI Colors & UI Constants ---
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    readonly C_RESET=$'\033[0m'
    readonly C_BOLD=$'\033[1m'
    readonly C_DIM=$'\033[0;90m'
    readonly C_CYAN=$'\033[1;36m'
    readonly C_BAR=$'\033[0;36m'
    readonly C_GREEN=$'\033[1;32m'
    readonly C_YELLOW=$'\033[1;33m'
    readonly C_RED=$'\033[1;31m'
    readonly C_BADGE=$'\033[1;30;46m'
else
    readonly C_RESET="" C_BOLD="" C_DIM="" C_CYAN="" C_BAR=""
    readonly C_GREEN="" C_YELLOW="" C_RED="" C_BADGE=""
fi

readonly CLEAR_LINE=$'\r\033[K'
readonly SPINNER_FRAMES=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
readonly HEADER_MARK="┃"

PANEL_IP=""
SKIP_UPGRADE=false
SKIP_WARP=false
SKIP_LOGS=false
REBOOT_RECOMMENDED=false
IPV6_USABLE=false
DEFAULT_IFACE="eth0"
TOTAL_RAM_MB=0
MAX_BUF=16777216
CONNTRACK_MAX=262144

# --- UI Helpers ---
msg_info() { printf ' %s[→]%s %s\n' "$C_CYAN" "$C_RESET" "$1"; }
msg_ok()   { printf ' %s[✓]%s %s\n' "$C_GREEN" "$C_RESET" "$1"; }
msg_warn() { printf ' %s[!]%s %s\n' "$C_YELLOW" "$C_RESET" "$1"; }
msg_err()  { printf ' %s[✗]%s %s\n' "$C_RED" "$C_RESET" "$1" >&2; }

print_section() {
    printf '\n %s%s%s %s%s%s\n' "$C_BAR" "$HEADER_MARK" "$C_RESET" "$C_CYAN" "$1" "$C_RESET"
}

print_banner() {
    printf '\n'
    printf ' %s%s%s %s %s\n' "$C_BAR" "$HEADER_MARK" "$C_RESET" "${C_BADGE} QUANTEQ ${C_RESET}" "${C_BOLD}VPS Optimizer & RemnaNode Installer${C_RESET}"
    printf ' %s%s%s %s\n\n' "$C_BAR" "$HEADER_MARK" "$C_RESET" "${C_DIM}BBRv1/FQ · Sysctl & Conntrack · UFW + ICMP Guard · Docker · WARP${C_RESET}"
}

run_with_spinner() {
    local label="$1"
    shift
    local frame_idx=0
    "$@" >>"$LOG_FILE" 2>&1 &
    local pid=$!

    if [[ -t 1 ]]; then
        while kill -0 "$pid" 2>/dev/null; do
            local frame="${SPINNER_FRAMES[frame_idx % ${#SPINNER_FRAMES[@]}]}"
            frame_idx=$((frame_idx + 1))
            printf '%s %s%s%s  %s' "$CLEAR_LINE" "$C_CYAN" "$frame" "$C_RESET" "$label"
            sleep 0.1
        done
        printf '%s' "$CLEAR_LINE"
    fi

    if wait "$pid"; then
        msg_ok "$label"
        return 0
    else
        msg_warn "$label (completed with warnings, check $LOG_FILE)"
        return 1
    fi
}

usage() {
    cat <<EOF
Usage: bash quanteq [OPTIONS]

Options:
  -p, --panel-ip IP    Set Panel IP (IPv4 or IPv6) non-interactively
      --skip-upgrade   Skip apt full-upgrade (faster execution)
      --skip-warp      Skip Cloudflare WARP installation
      --no-logs        Do not attach to docker compose logs at the end
  -h, --help           Show this help message
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -p|--panel-ip)     PANEL_IP="${2:-}"; shift 2 ;;
        --skip-upgrade)    SKIP_UPGRADE=true; shift ;;
        --skip-warp)       SKIP_WARP=true; shift ;;
        --no-logs)         SKIP_LOGS=true; shift ;;
        -h|--help)         usage; exit 0 ;;
        *)                 shift ;;
    esac
done

# --- Validations ---
validate_ip() {
    local ip="$1"
    [[ -z "$ip" ]] && return 1

    # IPv4 check
    if [[ "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
        local o1 o2 o3 o4 octet
        IFS='.' read -r o1 o2 o3 o4 <<<"$ip"
        for octet in "$o1" "$o2" "$o3" "$o4"; do
            ((10#$octet > 255)) && return 1
        done
        return 0
    fi

    # IPv6 check (supports compressed :: notation)
    if [[ "$ip" == *":"* && "$ip" =~ ^[0-9a-fA-F:]+$ && ! "$ip" =~ ::: ]]; then
        if command -v python3 &>/dev/null; then
            python3 -c "import ipaddress, sys; ipaddress.IPv6Address(sys.argv[1])" "$ip" &>/dev/null && return 0 || return 1
        fi
        [[ "$ip" =~ ^([0-9a-fA-F]{0,4}:){2,7}[0-9a-fA-F]{0,4}$ ]] && return 0
    fi

    return 1
}

# ==============================================================================
# 0. PRE-FLIGHT CHECKS & INPUT
# ==============================================================================
: >"$LOG_FILE"

if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
    if [[ -f "$0" ]] && command -v sudo &>/dev/null; then
        exec sudo -E bash "$0" "$@"
    else
        msg_err "Please run this script as root (sudo -i or su -)."
        exit 1
    fi
fi

if ! command -v apt-get &>/dev/null; then
    msg_err "This script only supports Debian/Ubuntu (apt-get not found)."
    exit 1
fi

print_banner

if [[ -z "$PANEL_IP" ]]; then
    if [[ ! -t 0 && ! -e /dev/tty ]]; then
        msg_err "No interactive terminal available. Pass --panel-ip <IP>."
        exit 1
    fi
    while true; do
        printf ' %s[?]%s Enter your Panel IP address (IPv4/IPv6 for port %s/tcp): ' "$C_CYAN" "$C_RESET" "$REMNANODE_PORT"
        read -r PANEL_IP </dev/tty
        PANEL_IP="${PANEL_IP//[[:space:]]/}"
        if validate_ip "$PANEL_IP"; then
            break
        fi
        msg_err "Invalid IP address: '${PANEL_IP:-empty}'. Please enter a valid IPv4 or IPv6."
    done
else
    PANEL_IP="${PANEL_IP//[[:space:]]/}"
    if ! validate_ip "$PANEL_IP"; then
        msg_err "Invalid --panel-ip address: '$PANEL_IP'."
        exit 1
    fi
fi

msg_ok "Panel IP accepted: ${C_BOLD}${PANEL_IP}${C_RESET}"

# ==============================================================================
# 1. SYSTEM PACKAGES & DOCKER
# ==============================================================================
print_section "1. System Update & Base Utilities"

APT_FLAGS=(-y -qq -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold")

run_with_spinner "Updating APT package lists" apt-get update -y
run_with_spinner "Installing base utilities (ufw, curl, iproute2, ethtool, htop)" \
    apt-get install "${APT_FLAGS[@]}" sudo ca-certificates curl ufw nano htop iproute2 ethtool kmod

if [[ "$SKIP_UPGRADE" == false ]]; then
    run_with_spinner "Upgrading system packages (full-upgrade)" apt-get full-upgrade "${APT_FLAGS[@]}"
    run_with_spinner "Cleaning up unused packages" apt-get autoremove "${APT_FLAGS[@]}"
else
    msg_info "Skipped system full-upgrade (--skip-upgrade)"
fi

if ! command -v docker &>/dev/null; then
    run_with_spinner "Installing Docker Engine & Compose plugin" bash -c "curl -fsSL https://get.docker.com | sh"
else
    msg_ok "Docker Engine is already installed"
fi

[[ -f /var/run/reboot-required ]] && REBOOT_RECOMMENDED=true

# ==============================================================================
# 2. UFW & ICMP RATE-LIMITING
# ==============================================================================
print_section "2. Firewall (UFW) & ICMP Protection"

if [[ -e /proc/net/if_inet6 ]] && [[ "$(cat /proc/sys/net/ipv6/conf/all/disable_ipv6 2>/dev/null || echo 1)" -eq 0 ]]; then
    IPV6_USABLE=true
fi

if [[ -f /etc/default/ufw ]]; then
    if [[ "$IPV6_USABLE" == true ]]; then
        sed -i 's/^IPV6=.*/IPV6=yes/' /etc/default/ufw
        msg_ok "IPv6 stack active: UFW configured for Dual-Stack (IPV6=yes)"
    else
        sed -i 's/^IPV6=.*/IPV6=no/' /etc/default/ufw
        msg_info "IPv6 disabled in kernel: UFW set to IPv4-only (IPV6=no)"
    fi
fi

# Fix legacy typo in before6.rules if present from older script versions
if [[ -f /etc/ufw/before6.rules ]] && grep -q "ufw-before-output -p icmpv6" /etc/ufw/before6.rules; then
    sed -i 's/-A ufw-before-output -p icmpv6/-A ufw6-before-output -p ipv6-icmp/g' /etc/ufw/before6.rules
    msg_ok "Fixed legacy chain name in /etc/ufw/before6.rules"
fi

configure_icmp_output_limit() {
    local rules_file="$1"
    local proto_marker="$2"

    [[ ! -f "$rules_file" ]] && return
    if grep -q "# --- ICMP unreachable rate-limit ($proto_marker) ---" "$rules_file"; then
        msg_ok "ICMP ($proto_marker) rate-limit already present in $(basename "$rules_file")"
        return
    fi
    if ! grep -q "^COMMIT$" "$rules_file"; then
        msg_warn "No COMMIT line found in $rules_file, skipping ICMP rule"
        return
    fi

    local icmp_type_match chain_prefix tmp_file
    if [[ "$proto_marker" == "icmp" ]]; then
        icmp_type_match="-p icmp --icmp-type destination-unreachable"
        chain_prefix="ufw-before-output"
    else
        icmp_type_match="-p ipv6-icmp --icmpv6-type destination-unreachable"
        chain_prefix="ufw6-before-output"
    fi

    tmp_file=$(mktemp)
    awk -v marker="$proto_marker" -v chain="$chain_prefix" -v match_str="$icmp_type_match" \
        -v limit="$ICMP_RATE_LIMIT" -v burst="$ICMP_RATE_BURST" '
        /^COMMIT$/ && !done {
            print "# --- ICMP unreachable rate-limit (" marker ") ---"
            print "-A " chain " " match_str " -m limit --limit " limit " --limit-burst " burst " -j ACCEPT"
            print "-A " chain " " match_str " -j DROP"
            print ""
            done = 1
        }
        { print }
    ' "$rules_file" > "$tmp_file"

    if [[ -s "$tmp_file" ]] && grep -q "^COMMIT$" "$tmp_file"; then
        cat "$tmp_file" > "$rules_file"
        msg_ok "Added ICMP ($proto_marker) rate-limit (${ICMP_RATE_LIMIT}) to $(basename "$rules_file")"
    fi
    rm -f "$tmp_file"
}

configure_icmp_output_limit /etc/ufw/before.rules "icmp"
[[ "$IPV6_USABLE" == true ]] && configure_icmp_output_limit /etc/ufw/before6.rules "icmpv6"

# Allow only TCP ports (22/tcp, 80/tcp, 443/tcp) and remove legacy 443/udp if present
ufw delete allow 443/udp >>"$LOG_FILE" 2>&1 || true
for port in 22/tcp 80/tcp 443/tcp; do
    ufw allow "$port" >>"$LOG_FILE" 2>&1 || true
done

# Remove outdated 2222/tcp rules (or rules with legacy comments)
ufw status numbered 2>/dev/null | grep "${REMNANODE_PORT}/tcp" | \
    awk -F'[][]' '{print $2}' | sort -rn | while read -r num; do
        [[ -n "$num" ]] && ufw --force delete "$num" >>"$LOG_FILE" 2>&1 || true
    done

ufw allow from "$PANEL_IP" to any port "$REMNANODE_PORT" proto tcp >>"$LOG_FILE" 2>&1 || true
msg_ok "Allowed ports 22/tcp, 80/tcp, 443/tcp and restricted ${REMNANODE_PORT}/tcp to ${PANEL_IP}"

if ! ufw status | grep -qw "active"; then
    ufw default deny incoming >>"$LOG_FILE" 2>&1 || true
    ufw default allow outgoing >>"$LOG_FILE" 2>&1 || true
    ufw --force enable >>"$LOG_FILE" 2>&1 && msg_ok "UFW firewall enabled" || msg_warn "UFW enable failed"
else
    ufw reload >>"$LOG_FILE" 2>&1 && msg_ok "UFW firewall reloaded" || msg_warn "UFW reload failed"
fi

# ==============================================================================
# 3. BBR, SYSCTL, CONNTRACK & SYSTEM LIMITS
# ==============================================================================
print_section "3. Kernel Network Tuning (BBR, Conntrack & Buffers)"

# Clean up legacy block from /etc/sysctl.conf if present
if [[ -f /etc/sysctl.conf ]] && grep -q "# --- BBR & Network Tweaks ---" /etc/sysctl.conf; then
    sed -i '/# --- BBR & Network Tweaks ---/,/net.ipv4.icmp_ratemask = 6160/d' /etc/sysctl.conf 2>/dev/null || true
    msg_ok "Cleaned up legacy network block from /etc/sysctl.conf"
fi

TOTAL_RAM_MB=$(awk '/MemTotal/ {print int($2/1024)}' /proc/meminfo)
if ((TOTAL_RAM_MB >= 7500)); then
    MAX_BUF=67108864
    DEF_BUF=1048576
    CONNTRACK_MAX=1048576
    CONNTRACK_BUCKETS=262144
elif ((TOTAL_RAM_MB >= 3500)); then
    MAX_BUF=33554432
    DEF_BUF=524288
    CONNTRACK_MAX=524288
    CONNTRACK_BUCKETS=131072
else
    MAX_BUF=16777216
    DEF_BUF=262144
    CONNTRACK_MAX=262144
    CONNTRACK_BUCKETS=65536
fi

msg_info "Detected ${TOTAL_RAM_MB} MB RAM -> Max Socket Buffer: $((MAX_BUF / 1048576)) MB, Conntrack: ${CONNTRACK_MAX}"

modprobe tcp_bbr 2>/dev/null || true
modprobe nf_conntrack 2>/dev/null || true
printf 'tcp_bbr\nnf_conntrack\n' > /etc/modules-load.d/quanteq-net.conf
rm -f /etc/modules-load.d/nf_conntrack.conf

cat <<EOF > /etc/sysctl.d/99-network-tune.conf
# --- BBR & Packet Scheduler ---
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr

# --- Queues & Backlogs ---
net.core.somaxconn = 32768
net.core.netdev_max_backlog = 65536
net.core.netdev_budget = 600
net.core.netdev_budget_usecs = 8000
net.ipv4.tcp_max_syn_backlog = 32768

# --- Socket Buffers ---
net.core.rmem_max = ${MAX_BUF}
net.core.wmem_max = ${MAX_BUF}
net.core.rmem_default = ${DEF_BUF}
net.core.wmem_default = ${DEF_BUF}
net.core.optmem_max = 262144
net.ipv4.tcp_rmem = 4096 131072 ${MAX_BUF}
net.ipv4.tcp_wmem = 4096 131072 ${MAX_BUF}

# --- UDP Optimizations  ---
net.ipv4.udp_mem = 65536 131072 262144
net.ipv4.udp_rmem_min = 32768
net.ipv4.udp_wmem_min = 32768

# --- Latency, Stealth ---
net.ipv4.tcp_slow_start_after_idle = 0
net.ipv4.tcp_fastopen = 0
net.ipv4.tcp_notsent_lowat = 131072
net.ipv4.tcp_mtu_probing = 1
net.ipv4.tcp_sack = 1
net.ipv4.tcp_dsack = 1
net.ipv4.tcp_window_scaling = 1
net.ipv4.tcp_adv_win_scale = 1

# --- Timeouts, Orphans & Protection ---
net.ipv4.tcp_tw_reuse = 1
net.ipv4.tcp_fin_timeout = 15
net.ipv4.tcp_keepalive_time = 600
net.ipv4.tcp_keepalive_intvl = 30
net.ipv4.tcp_keepalive_probes = 5
net.ipv4.tcp_orphan_retries = 2
net.ipv4.tcp_max_orphans = 131072
net.ipv4.tcp_syncookies = 1
net.ipv4.icmp_ratemask = 6160
net.ipv4.ip_local_port_range = 10240 65535
fs.file-max = 2097152

# --- Conntrack Tuning ---
net.netfilter.nf_conntrack_max = ${CONNTRACK_MAX}
net.netfilter.nf_conntrack_tcp_timeout_established = 1800
net.netfilter.nf_conntrack_tcp_timeout_time_wait = 30
net.netfilter.nf_conntrack_tcp_timeout_close_wait = 15
net.netfilter.nf_conntrack_tcp_timeout_fin_wait = 30
EOF

mkdir -p /etc/systemd/system.conf.d
cat <<'EOF' > /etc/systemd/system.conf.d/limits.conf
[Manager]
DefaultLimitNOFILE=1048576
EOF

cat <<'EOF' > /etc/security/limits.d/99-nofile.conf
* soft nofile 1048576
* hard nofile 1048576
root soft nofile 1048576
root hard nofile 1048576
EOF

systemctl daemon-reexec >>"$LOG_FILE" 2>&1 || true

DEFAULT_IFACE=$(ip route get 8.8.8.8 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="dev") {print $(i+1); exit}}')
[[ -z "$DEFAULT_IFACE" ]] && DEFAULT_IFACE=$(ip -6 route get 2001:4860:4860::8888 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="dev") {print $(i+1); exit}}')
[[ -z "$DEFAULT_IFACE" ]] && DEFAULT_IFACE="eth0"

cat <<EOF > /etc/systemd/system/network-tune-persist.service
[Unit]
Description=Apply sysctl, conntrack and NIC queue optimizations after boot
After=network-online.target systemd-sysctl.service docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/sbin/modprobe nf_conntrack
ExecStart=/usr/sbin/sysctl --system
ExecStart=/bin/sh -c 'echo ${CONNTRACK_BUCKETS} > /sys/module/nf_conntrack/parameters/hashsize || true'
ExecStart=/sbin/ip link set dev ${DEFAULT_IFACE} txqueuelen 10000
ExecStart=/bin/sh -c '/sbin/tc qdisc replace dev ${DEFAULT_IFACE} root mq 2>/dev/null || /sbin/tc qdisc replace dev ${DEFAULT_IFACE} root fq || true'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
if systemctl enable --now network-tune-persist.service >>"$LOG_FILE" 2>&1; then
    msg_ok "Applied sysctl BBR, file limits & persistent NIC queue tuning (${DEFAULT_IFACE})"
else
    msg_warn "network-tune-persist service reported warnings"
fi

# ==============================================================================
# 4. CLOUDFLARE WARP (NATIVE WIREGUARD)
# ==============================================================================
print_section "4. Cloudflare WARP (Native WireGuard)"

if [[ "$SKIP_WARP" == true ]]; then
    msg_info "Skipped WARP installation (--skip-warp)"
elif [[ -f /etc/wireguard/warp.conf ]]; then
    msg_ok "WARP configuration already exists (/etc/wireguard/warp.conf)"
else
    run_with_spinner "Installing Cloudflare WARP (distillium/warp-native)" \
        timeout 120s bash -c 'printf "1\n \n1\n" | bash <(curl -fsSL https://raw.githubusercontent.com/distillium/warp-native/main/install.sh)' || true
fi

# ==============================================================================
# 5. REMNANODE CONFIGURATION & STARTUP
# ==============================================================================
print_section "5. RemnaNode Setup & Docker Compose"

mkdir -p "$REMNANODE_DIR"
cd "$REMNANODE_DIR" || { msg_err "Cannot enter $REMNANODE_DIR"; exit 1; }

if [[ ! -s "docker-compose.yml" ]]; then
    printf '\n'
    printf ' %s╭─ Action Required: Paste docker-compose.yml ──────────────╮%s\n' "$C_CYAN" "$C_RESET"
    printf ' %s│%s  1. Nano editor will open in 2 seconds                   %s│%s\n' "$C_CYAN" "$C_RESET" "$C_CYAN" "$C_RESET"
    printf ' %s│%s  2. Paste your RemnaNode compose configuration           %s│%s\n' "$C_CYAN" "$C_RESET" "$C_CYAN" "$C_RESET"
    printf ' %s│%s  3. Save with %sCtrl+O, Enter%s and exit with %sCtrl+X%s         %s│%s\n' "$C_CYAN" "$C_RESET" "$C_BOLD" "$C_RESET" "$C_BOLD" "$C_RESET" "$C_CYAN" "$C_RESET"
    printf ' %s╰──────────────────────────────────────────────────────────╯%s\n\n' "$C_CYAN" "$C_RESET"
    sleep 2
    nano docker-compose.yml </dev/tty || msg_warn "Nano editor exited with non-zero status"

    if [[ ! -s "docker-compose.yml" ]]; then
        msg_err "docker-compose.yml is still empty. Aborting before starting containers."
        exit 1
    fi
    msg_ok "Saved docker-compose.yml"
else
    msg_ok "Existing docker-compose.yml found in ${REMNANODE_DIR}"
fi

docker image prune -f >>"$LOG_FILE" 2>&1 || true

run_with_spinner "Pulling images & starting RemnaNode containers" timeout 120s docker compose up -d || true

if [[ "$REBOOT_RECOMMENDED" == true ]]; then
    printf '\n %s[!]%s %sA kernel update was installed. Reboot is recommended:%s %sreboot%s\n' \
        "$C_YELLOW" "$C_RESET" "$C_YELLOW" "$C_RESET" "$C_BOLD" "$C_RESET"
fi

if [[ "$SKIP_LOGS" == false ]]; then
    print_section "Live Container Logs (Press Ctrl+C to exit)"
    docker compose logs -f -t --tail=50 || msg_warn "Cannot attach to container logs"
fi
