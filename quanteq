#!/usr/bin/env bash

if [ "$EUID" -ne 0 ]; then
    if command -v sudo &> /dev/null; then
        echo "Reload with sudo..."
        exec sudo bash "$0" "$@"
    else
        echo "Need root access (su -)."
        exit 1
    fi
fi

# Убрали set -e, теперь скрипт не умирает при первой же ошибке

echo "--- 1. Update & Download base utilities ---"
if ! command -v docker &> /dev/null || ! command -v ufw &> /dev/null; then
    timeout 120s apt update || echo "Warning: apt update failed or timed out."
    timeout 120s apt install -y sudo curl ufw nano || echo "Warning: apt install failed or timed out."
    timeout 120s curl -fsSL https://get.docker.com | sh || echo "Warning: Docker installation failed or timed out."
else
    echo "Skipped: Base utilities and Docker are already installed."
fi

echo "--- 2. Settings for UFW ---"
if ! ufw status | grep -qw "active"; then
    # Если ufw выдает ошибку, просто идем дальше (|| true игнорирует ошибку)
    ufw allow ssh || true
    ufw allow from 5.231.119.98 to any port 2222 proto tcp || true
    ufw allow 443/tcp || true
    ufw default deny incoming || true
    ufw default allow outgoing || true
    ufw --force enable || echo "Warning: UFW enable failed."
else
    echo "Skipped: UFW is already active."
fi

echo "--- 3. Enable BBR ---"
if ! grep -q "net.ipv4.tcp_congestion_control=bbr" /etc/sysctl.conf; then
    (echo "net.core.default_qdisc=fq" >> /etc/sysctl.conf && \
     echo "net.ipv4.tcp_congestion_control=bbr" >> /etc/sysctl.conf && \
     sudo sysctl --system) || echo "Warning: BBR setup failed."
else
    echo "Skipped: BBR is already configured."
fi

echo "--- 4. WARP Installation ---"
if ! docker ps -a --format '{{.Names}}' | grep -Eq "^warp$"; then
    echo "Starting WARP installation (max wait: 120s)..."
    timeout 120s bash -c 'printf "1\n\ny\n\n0\n" | bash -c "$(curl -sL https://raw.githubusercontent.com/xxphantom/docker-warp-native/main/install.sh)"' || echo "Warning: WARP installation failed or timed out! Skipping..."
else
    echo "Skipped: WARP container already exists."
fi

echo "--- 5. Install RemnaNode ---"
mkdir -p /opt/remnanode || true
cd /opt/remnanode || echo "Warning: Cannot enter /opt/remnanode directory."

if [ ! -s "docker-compose.yml" ]; then
    echo "-------------------------------------------------------"
    echo "Nano is opening soon"
    echo "1. Get config"
    echo "2. Ctrl+O, Enter"
    echo "3. Ctrl+X"
    echo "-------------------------------------------------------"
    sleep 2

    nano docker-compose.yml < /dev/tty || echo "Warning: Nano editor failed."
else
    echo "Skipped: docker-compose.yml already exists and is not empty."
fi

echo "--- 6. Start Docker Compose ---"
timeout 120s docker compose up -d || echo "Warning: Docker compose failed or timed out."

echo "--- 7. Logs (Ctrl + C for exit) ---"
docker compose logs -f -t || echo "Warning: Cannot show logs."
